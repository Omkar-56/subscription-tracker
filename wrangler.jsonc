{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subtrack",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "./stubs/iconv-lite.js"
  },
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
