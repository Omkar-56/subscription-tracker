PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subtrack

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS / App URL
CLIENT_ORIGIN=https://subspens.com

# Google OAuth (Optional - used for audience verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Gemini LLM Receipt Parser API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Resend Email Configuration (Primary Provider for subspens.com)
# ------------------------------------------------------------------------------
# 1. Sign up at https://resend.com and add the domain "subspens.com"
# 2. Add DNS records (SPF, DKIM, DMARC) in your domain registrar
# 3. Create an API key at https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Subspens <reminder@subspens.com>

# ------------------------------------------------------------------------------
# Optional SMTP Fallback Configuration
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_gmail_app_password

# Optional: Cron Secret (protects /api/reminders/cron from unauthorized requests)
CRON_SECRET=your_random_cron_secret
